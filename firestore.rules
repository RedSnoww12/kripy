rules_version = '2';

// Règles de sécurité Firestore pour Kripy.
//
// À déployer dans la console Firebase (Firestore Database → Règles) ou via
// la CLI : `firebase deploy --only firestore:rules`
//
// Sans ces règles, les recettes publiques échouent silencieusement : la
// collection `sharedRecipes` doit être lisible par tous les utilisateurs
// authentifiés, alors que chaque document ne peut être créé/modifié/supprimé
// que par son auteur — c'est ce qui garantit le « lecture seule » côté
// serveur, et pas seulement dans l'interface.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Données personnelles ──
    // Un utilisateur n'accède qu'à son propre document (sauvegarde cloud).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Recettes publiques (bibliothèque commune) ──
    match /sharedRecipes/{recipeId} {
      // Forme minimale d'une recette publique : un nom exploitable et un
      // tuple de 5 macros. Vaut aussi bien à la création qu'à la mise à jour.
      function validShape() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.tuple is list
          && request.resource.data.tuple.size() == 5;
      }

      // Lecture : tout utilisateur authentifié profite de la base commune.
      // C'est ce qui rend les recettes publiques « en lecture seule » pour
      // les autres : ils les voient, mais aucune écriture ne leur est permise.
      allow read: if request.auth != null;

      // Création : uniquement pour soi-même, avec une forme de document
      // valide (empêche d'injecter n'importe quoi dans la base commune).
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && validShape();

      // Modification : réservée à l'auteur, l'auteur ne peut pas être
      // réattribué, et la forme reste vérifiée (une mise à jour ne doit pas
      // pouvoir contourner les contrôles de la création).
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid
        && validShape();

      // Suppression (dépublication) : réservée à l'auteur.
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
