rules_version = '2';

// Règles de sécurité Firestore pour Kripy.
//
// À déployer dans la console Firebase (Firestore Database → Règles) ou via
// la CLI : `firebase deploy --only firestore:rules`
//
// Sans ces règles, le partage de recettes échoue silencieusement : la
// collection `sharedRecipes` doit être lisible par tous les utilisateurs
// authentifiés, alors que chaque document ne peut être créé/modifié/supprimé
// que par son auteur.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Données personnelles ──
    // Un utilisateur n'accède qu'à son propre document (sauvegarde cloud).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Recettes partagées (bibliothèque commune) ──
    match /sharedRecipes/{recipeId} {
      // Lecture : tout utilisateur authentifié profite de la base commune.
      allow read: if request.auth != null;

      // Création : uniquement pour soi-même, avec une forme de document
      // valide (empêche d'injecter n'importe quoi dans la base commune).
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.tuple is list
        && request.resource.data.tuple.size() == 5;

      // Modification / suppression : réservées à l'auteur, et l'auteur ne
      // peut pas être réattribué.
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
